# La Parola Giusta — configurazione Apache (Aruba)

# --- 1. HTTPS obbligatorio + dominio senza www --------------------------
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://laparolagiusta.it/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.laparolagiusta\.it$ [NC]
RewriteRule ^(.*)$ https://laparolagiusta.it/$1 [R=301,L]

# --- 2. Compressione ----------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- 3. Cache del browser ----------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/x-icon          "access plus 1 year"
  ExpiresByType font/woff2            "access plus 1 year"
  ExpiresByType text/css              "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html             "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpg|jpeg|png|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # --- 4. Intestazioni di sicurezza -------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --- 5. Tipi MIME che Aruba non sempre dichiara -------------------------
AddType image/webp .webp
AddType font/woff2 .woff2

# --- 6. Pagina di errore ------------------------------------------------
ErrorDocument 404 /404.html
